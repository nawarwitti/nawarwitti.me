---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile, getUi, isRtl, LOCALES, switchLocale, type Locale } from '../lib/content';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
  type?: 'website' | 'article';
}
const { title, description, locale, image = '/og-image.png', type = 'website' } = Astro.props;

const ui = await getUi(locale);
const profile = await getProfile(locale);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const alternates = LOCALES.map((l) => ({
  locale: l,
  href: new URL(switchLocale(Astro.url.pathname, l), Astro.site).href,
}));
const otherOgLocales = LOCALES.filter((l) => l !== locale).map((l) => ui.ogLocales[l]);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: ui.personJobTitle,
  description: profile.summary,
  url: profile.website,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Sakarya', addressCountry: 'TR' },
  alumniOf: profile.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsLanguage: ['ar', 'tr', 'en'],
  sameAs: [profile.linkedin],
};
---

<!doctype html>
<html lang={locale} dir={isRtl(locale) ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ui.ogLocales[locale]} />
    {otherOgLocales.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,600&display=swap"
    />
    {locale === 'ar' && (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Noto+Naskh+Arabic:wght@600&display=swap"
      />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Marks JS as available before paint, so scroll-reveal hides only when it can show again -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-[6px] bg-pulse px-4 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:start-3"
    >
      {ui.skipLink}
    </a>
    <Header ui={ui} locale={locale} name={profile.name} cv={profile.cv} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer ui={ui} />

    <script>
      // Scroll reveal: [data-reveal] elements fade up when they enter the screen.
      // Children of [data-stagger] reveal one after another.
      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        Array.from(group.children).forEach((child, i) => {
          const el = child as HTMLElement;
          el.dataset.reveal = '';
          el.style.setProperty('--reveal-delay', `${Math.min(i, 8) * 90}ms`);
        });
      });
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
      // Never print half-revealed content.
      window.addEventListener('beforeprint', () =>
        items.forEach((el) => el.classList.add('is-visible')),
      );
    </script>
  </body>
</html>
