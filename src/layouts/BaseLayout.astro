---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile, getUi, DEFAULT_LOCALE } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  locale?: string;
}
const {
  title,
  description,
  image = '/og-image.png',
  type = 'website',
  locale = DEFAULT_LOCALE,
} = Astro.props;

const ui = await getUi(locale);
const profile = await getProfile();

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Electrical & Electronics Engineer',
  description: profile.summary,
  url: profile.website,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Sakarya', addressCountry: 'TR' },
  alumniOf: profile.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsLanguage: ['ar', 'tr', 'en'],
  sameAs: [profile.linkedin],
};
---

<!doctype html>
<html lang={ui.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#111111" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-[6px] bg-pulse px-4 py-3 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {ui.skipLink}
    </a>
    <Header ui={ui} name={profile.name} cv={profile.cv} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer ui={ui} />
  </body>
</html>
