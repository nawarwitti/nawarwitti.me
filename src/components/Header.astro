---
import PulseLine from './PulseLine.astro';
import { LOCALES, localePath, switchLocale, type Locale, type Ui } from '../lib/content';

interface Props {
  ui: Ui;
  locale: Locale;
  name: string;
  cv: string;
}
const { ui, locale, name, cv } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: localePath(locale, '/projects/'), label: ui.nav.projects },
  { href: localePath(locale, '/experience/'), label: ui.nav.experience },
  { href: localePath(locale, '/about/'), label: ui.nav.about },
  { href: localePath(locale, '/contact/'), label: ui.nav.contact },
];
const isActive = (href: string) => path.startsWith(href);
---

<header class="on-dark top-0 z-40 border-b border-carbon-line bg-carbon md:sticky md:bg-carbon/85 md:backdrop-blur-md">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4">
    <a
      href={localePath(locale, '/')}
      class="flex min-h-11 items-center gap-2.5 font-serif text-[22px] text-on-dark no-underline"
    >
      <PulseLine variant="logo" sweep />
      {name}
    </a>
    <nav aria-label={ui.nav.label}>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 text-[15px]">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center no-underline hover:text-on-dark',
                isActive(l.href)
                  ? 'text-on-dark underline decoration-pulse decoration-2 underline-offset-8'
                  : 'text-on-dark-2',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={cv}
            data-goatcounter-click="cv-download"
            download
            class="inline-flex min-h-11 items-center rounded-[6px] border border-outline-dark px-4 text-on-dark no-underline hover:border-on-dark-3"
          >
            {ui.nav.cv}
          </a>
        </li>
        <li>
          <ul
            class="flex items-center gap-1 font-mono text-[13px]"
            aria-label={ui.nav.languageLabel}
          >
            {LOCALES.map((l) => (
              <li>
                <a
                  href={switchLocale(path, l)}
                  hreflang={l}
                  lang={l}
                  aria-current={l === locale ? 'true' : undefined}
                  class:list={[
                    'inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] no-underline',
                    l === locale
                      ? 'bg-carbon-line text-on-dark'
                      : 'text-on-dark-3 hover:text-on-dark',
                  ]}
                >
                  {ui.langNames[l]}
                </a>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>
