---
import Placeholder from './Placeholder.astro';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';
import { projectUrl, type Locale, type Project, type Ui } from '../lib/content';

interface Props {
  ui: Ui;
  locale: Locale;
  project: Project;
  showTags?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { ui, locale, project, showTags = false, headingLevel = 'h3' } = Astro.props;
const p = project.data;
const Heading = headingLevel;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-[12px] border border-card-border bg-card transition duration-300 hover:-translate-y-1 hover:border-ink-3 hover:shadow-[0_18px_40px_-20px_rgb(17_17_17_/_0.45)] motion-reduce:hover:translate-y-0"
  data-tags={p.tags.join('|')}
  data-glow
  data-tilt
>
  <div class="overflow-hidden border-b border-card-border">
    <Placeholder
      label={p.cover.label}
      src={p.cover.src}
      alt={p.cover.alt}
      fit={p.cover.fit}
      width={400}
      height={170}
      class="h-[170px] w-full border-0 transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:group-hover:scale-100"
    />
  </div>
  <span
    class="pointer-events-none absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-pulse transition-transform duration-500 group-hover:scale-x-100 rtl:origin-right"
    aria-hidden="true"
  ></span>
  <div class="flex flex-grow flex-col gap-2.5 p-5">
    <p class="font-mono text-xs text-pulse-text-light">{p.tags[0]}</p>
    <Heading class="text-[21px] leading-[1.25]">
      <a
        href={projectUrl(locale, project.slug)}
        class="text-ink no-underline after:absolute after:inset-0"
      >
        {p.title}
      </a>
    </Heading>
    <p class="text-[15px] leading-[1.55] text-ink-2">{p.summary}</p>
    {showTags && (
      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        <StatusBadge status={p.status} label={ui.projects.status[p.status]} />
        {p.tags.map((t) => (
          <Tag>{t}</Tag>
        ))}
      </div>
    )}
  </div>
</article>
