---
import Tag from './Tag.astro';
import StatusBadge from './StatusBadge.astro';
import { projectUrl, type Locale, type Project, type Ui } from '../lib/content';

interface Props {
  ui: Ui;
  locale: Locale;
  project: Project;
}
const { ui, locale, project } = Astro.props;
const p = project.data;
const stats = p.results.slice(0, 3);
---

<div>
  <p class="eyebrow mb-3 text-pulse-text-light">{ui.home.featuredLabel}</p>
  <article class="flex flex-wrap items-start gap-12 rounded-[12px] border border-card-border bg-card p-6 sm:p-10">
    <div class="min-w-0 flex-[999_1_460px]">
      <div class="mb-4 flex flex-wrap gap-2">
        <StatusBadge status={p.status} label={ui.projects.status[p.status]} />
        {p.tags.map((t) => (
          <Tag>{t}</Tag>
        ))}
      </div>
      <h2 class="text-[30px] leading-[1.15] sm:text-[38px]">{p.title}</h2>
      <p class="mt-4 text-[17px] leading-[1.65] text-ink-2">
        {p.summary} {p.context}.
      </p>
      <ul class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {stats.map((s) => (
          <li class="rounded-[8px] bg-paper p-4">
            <p class="font-serif text-[26px] leading-tight lg:text-[30px]">{s.value}</p>
            <p class="mt-1 text-[13px] text-ink-3">{s.label}</p>
          </li>
        ))}
      </ul>
      <a href={projectUrl(locale, project.slug)} class="link-light mt-7 inline-block text-base">
        {ui.home.caseStudyLink}
      </a>
    </div>
    <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-2.5">
      <p class="mb-1 font-mono text-[13px] text-ink-3">{ui.home.signalChainLabel}</p>
      <ol class="flex flex-col gap-2.5">
        {p.chain.map((c, i) => (
          <li
            class:list={[
              'rounded-[6px] px-3.5 py-3 text-[15px]',
              i === p.chain.length - 1 ? 'border-[1.5px] border-pulse' : 'border border-[#D9D5CC]',
            ]}
          >
            {c.name} <span class="text-ink-3">— {c.role}</span>
          </li>
        ))}
      </ol>
      {p.chainNote && <p class="mt-1 font-mono text-xs text-ink-3">{p.chainNote}</p>}
    </div>
  </article>
</div>
