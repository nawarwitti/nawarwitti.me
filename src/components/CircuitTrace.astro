---
// A copper trace down the side of the page (wide screens only). As the visitor scrolls,
// "current" flows down it and a solder pad lights up at the start of each section.
// The pads are placed by src/scripts/effects.ts. Purely decorative.
---

<div class="circuit-trace" data-trace aria-hidden="true">
  <span class="trace-track"></span>
  <span class="trace-fill"></span>
  <span class="trace-head"></span>
</div>
