---
import PulseLine from './PulseLine.astro';
import QuickFacts from './QuickFacts.astro';
import CircuitBackdrop from './CircuitBackdrop.astro';
import { localePath, type Locale, type Profile, type Ui } from '../lib/content';

interface Props {
  ui: Ui;
  locale: Locale;
  profile: Profile;
}
const { ui, locale, profile } = Astro.props;
// Each word animates in on its own (see .hero-word in global.css).
const words = profile.pitch.split(/\s+/);
---

<section class="on-dark relative isolate overflow-hidden bg-carbon text-on-dark">
  <CircuitBackdrop variant="hero" />
  <div class="container-page relative pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="max-w-[940px]">
      <p class="eyebrow hero-fade mb-5 text-pulse-text-dark" style="--d: 60ms">
        {ui.home.eyebrow}
      </p>
      <h1 class="text-[40px] leading-[1.12] tracking-[-0.01em] sm:text-[52px] lg:text-[64px]">
        {words.map((w, i) => (
          <>
            <span class="hero-word" style={`--i:${i}`}>
              {w}
            </span>{' '}
          </>
        ))}
      </h1>
      <p
        class="hero-fade mt-7 max-w-[680px] text-lg leading-relaxed text-on-dark-2 sm:text-[19px]"
        style={`--d: ${250 + words.length * 75}ms`}
      >
        {profile.summary}
      </p>
      <div
        class="hero-fade mt-9 flex flex-wrap gap-3.5"
        style={`--d: ${400 + words.length * 75}ms`}
      >
        <a href={localePath(locale, '/projects/')} class="btn-primary">
          {ui.home.buttons.projects}
        </a>
        <a href={profile.cv} download class="btn-outline-dark">
          {ui.home.buttons.cv}
        </a>
        <a href={profile.linkedin} rel="me noopener" target="_blank" class="btn-outline-dark">
          {ui.home.buttons.linkedin}
        </a>
      </div>
    </div>
  </div>
  <PulseLine variant="hero" animate sweep class="relative" />
  <div class="relative">
    <QuickFacts facts={profile.quickFacts} />
  </div>
</section>
