---
import PulseLine from './PulseLine.astro';
import type { Profile, Ui } from '../lib/content';

interface Props {
  ui: Ui;
  profile: Profile;
  headingLevel?: 'h1' | 'h2';
}
const { ui, profile, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section id="contact" class="on-dark border-t border-carbon-line bg-carbon text-on-dark">
  <div class="container-page pt-20 pb-16 sm:pt-24">
    <PulseLine variant="small" />
    <Heading class="mt-5 text-[38px] leading-[1.1] sm:text-[52px]">{ui.contact.heading}</Heading>
    <p class="mt-4 max-w-[560px] text-lg leading-relaxed text-on-dark-2">{ui.contact.text}</p>
    <div class="mt-8 flex flex-wrap gap-3.5">
      <a href={`mailto:${profile.email}`} class="btn-primary break-all">
        {profile.email}
      </a>
      <a href={profile.linkedin} rel="me noopener" target="_blank" class="btn-outline-dark">
        {ui.contact.linkedin}
      </a>
    </div>
  </div>
</section>
