---
interface Props {
  facts: { value: string; label: string }[];
}
const { facts } = Astro.props;
---

<div class="border-t border-carbon-line">
  <ul class="container-page grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6 pt-8 pb-10">
    {facts.map((f) => (
      <li>
        <p class="font-serif text-[26px]">{f.value}</p>
        <p class="mt-1.5 text-sm text-on-dark-3">{f.label}</p>
      </li>
    ))}
  </ul>
</div>
