---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Timeline from '../components/Timeline.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ContactCTA from '../components/ContactCTA.astro';
import {
  getExperience,
  getProfile,
  getProjects,
  getSkills,
  getUi,
  localePath,
  type Locale,
} from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const ui = await getUi(locale);
const profile = await getProfile(locale);
const projects = await getProjects(locale);
const experience = await getExperience(locale);
const skills = await getSkills(locale);

const featured = projects.find((p) => p.data.featured) ?? projects[0];
const selected = projects.filter((p) => p.slug !== featured.slug).slice(0, 4);
---

<BaseLayout title={ui.home.metaTitle} description={ui.home.metaDescription} locale={locale}>
  <Hero ui={ui} locale={locale} profile={profile} />

  <section id="projects" class="container-page pt-20 pb-10 sm:pt-26">
    <FeaturedProject ui={ui} locale={locale} project={featured} />

    <div class="mt-20 mb-7 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[30px] sm:text-[34px]">{ui.home.selectedHeading}</h2>
      <a href={localePath(locale, '/projects/')} class="link-light text-base">
        {ui.home.allProjectsLink}
      </a>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-5">
      {selected.map((p) => (
        <ProjectCard ui={ui} locale={locale} project={p} />
      ))}
    </div>
  </section>

  <section id="experience" class="container-page pt-16 pb-24">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-[30px] sm:text-[34px]">{ui.home.experienceHeading}</h2>
      <a href={localePath(locale, '/experience/')} class="link-light text-base">
        {ui.home.experienceLink}
      </a>
    </div>
    <Timeline items={experience.slice(0, 4)} mode="preview" ui={ui} />
  </section>

  <section id="skills" aria-label={ui.home.skillsHeading} class="on-dark bg-carbon text-on-dark">
    <div class="container-page grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-14 py-24">
      <SkillGroup group={skills.engineering} />
      <SkillGroup group={skills.business} />
    </div>
  </section>

  <ContactCTA ui={ui} profile={profile} />
</BaseLayout>
